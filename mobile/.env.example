# Mobile - Environment Variables Example
# Copy to mobile/.env.local and update values
# For Expo, use EXPO_PUBLIC_ prefix for public variables

# ==========================================
# API CONFIGURATION
# ==========================================
EXPO_PUBLIC_API_URL=http://localhost:8080/api
EXPO_PUBLIC_API_TIMEOUT=30000

# For production
# EXPO_PUBLIC_API_URL=https://api.englishcareer.ai

# ==========================================
# ENVIRONMENT
# ==========================================
EXPO_PUBLIC_ENV=development
# Options: development, staging, production

# ==========================================
# FEATURE FLAGS
# ==========================================
EXPO_PUBLIC_ENABLE_AI_EVALUATION=true
EXPO_PUBLIC_ENABLE_OFFLINE_SYNC=true
EXPO_PUBLIC_ENABLE_ANALYTICS=false
EXPO_PUBLIC_ENABLE_CRASH_REPORTING=false

# ==========================================
# LOGGING & DEBUG
# ==========================================
EXPO_PUBLIC_LOG_LEVEL=debug
# Options: debug, info, warn, error
EXPO_PUBLIC_DEBUG_MODE=true

# ==========================================
# OPTIONAL: ANALYTICS & MONITORING
# ==========================================
# EXPO_PUBLIC_ANALYTICS_ENABLED=false
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project
# EXPO_PUBLIC_AMPLITUDE_API_KEY=your-amplitude-key
# EXPO_PUBLIC_MIXPANEL_TOKEN=your-mixpanel-token

# ==========================================
# OPTIONAL: ERROR TRACKING
# ==========================================
# EXPO_PUBLIC_SENTRY_DSN=https://your-sentry-dsn
# EXPO_PUBLIC_SENTRY_ENVIRONMENT=development

# ==========================================
# OPTIONAL: PUSH NOTIFICATIONS
# ==========================================
# EXPO_PUBLIC_EXPO_PROJECT_ID=your-expo-project-id

# ==========================================
# UI & APPEARANCE
# ==========================================
EXPO_PUBLIC_THEME=light
# Options: light, dark, auto

# ==========================================
# SYNC & OFFLINE
# ==========================================
EXPO_PUBLIC_SYNC_INTERVAL_MINUTES=5
EXPO_PUBLIC_OFFLINE_DOWNLOAD_ON_WIFI=true
EXPO_PUBLIC_OFFLINE_CACHE_SIZE_MB=100

# ==========================================
# DEVELOPMENT ONLY
# ==========================================
EXPO_PUBLIC_MOCK_API=false
EXPO_PUBLIC_SKIP_AUTH=false

# ==========================================
# SECURITY WARNING
# ==========================================
# NEVER commit actual .env files to Git!
# 
# For Expo:
# - Public variables (EXPO_PUBLIC_*) are embedded in the app binary
# - Secret variables should be handled via EAS Secrets or environment setup
# 
# Local development:
# - Use .env.local (ignored by git)
# - Use .env.development for dev-specific values
# 
# For EAS builds, configure secrets in eas.json or EAS dashboard
