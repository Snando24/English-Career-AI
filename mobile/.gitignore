# Mobile - React Native / Expo .gitignore

# ==========================================
# NODE MODULES & PACKAGE MANAGERS
# ==========================================
node_modules/
npm-debug.log*
npm-debug.log*.*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# ==========================================
# EXPO SPECIFIC
# ==========================================
.expo/
.expo-shared/
dist/
build/
*.jks
*.mobileprovision
*.orig.*
eas-build-on-this-machine.json
.env.local
.env.*.local

# ==========================================
# REACT NATIVE SPECIFIC
# ==========================================
android/
ios/
.gradle/
gradle-wrapper.jar
.DS_Store
*.orig
.rncache
React\ Native\ Debugger.log

# ==========================================
# IDE - VS Code
# ==========================================
.vscode/
*.code-workspace
launch.json
settings.json
extensions.json

# ==========================================
# IDE - IntelliJ / Android Studio
# ==========================================
.idea/
.gradle
local.properties
*.iml
*.iws
*.ipr
out/

# ==========================================
# XCODE (iOS)
# ==========================================
DerivedData/
build/
*.xcworkspace
xcuserdata/
*.xcarchive
*.ipa

# ==========================================
# ENVIRONMENT & SECRETS
# ==========================================
.env
.env.local
.env.development
.env.production
.env.test
.env.*.local
secrets/
credentials/
api-keys.json
oauth.json

# ==========================================
# BUILD ARTIFACTS
# ==========================================
build/
dist/
.next/
out/
*.tar.gz
*.zip

# ==========================================
# CACHES
# ==========================================
.cache
.sass-cache
.eslintcache
.stylelintcache
node_modules/.cache
.turbo

# ==========================================
# FASTLANE (iOS/Android automation)
# ==========================================
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output

# ==========================================
# TESTING
# ==========================================
coverage/
.nyc_output/
junit.xml
test-results/
*.lcov

# ==========================================
# LOGS
# ==========================================
logs/
*.log
npm-debug.log
yarn-debug.log
lerna-debug.log

# ==========================================
# TEMPORARY FILES
# ==========================================
tmp/
temp/
*.swp
*.swo
*~
.tmp
.DS_Store

# ==========================================
# OS SPECIFIC
# ==========================================
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.directory

# ==========================================
# BABEL
# ==========================================
.babelcache
babel.config.js.bak

# ==========================================
# TYPESCRIPT
# ==========================================
*.tsbuildinfo
dist/
build/

# ==========================================
# DATABASE (SQLite local)
# ==========================================
*.db
*.sqlite
*.sqlite3
sqlite_data/

# ==========================================
# NATIVE BUILD ARTIFACTS
# ==========================================
# Android
android/app/debug/
android/app/release/
*.apk
*.aab

# iOS
ios/Pods/
ios/Podfile.lock

# ==========================================
# SECURITY - NEVER COMMIT
# ==========================================
*.key
*.pem
*.p12
.vault
vault-password
.credentials
.token

# ==========================================
# METRO BUNDLER
# ==========================================
.metro
.metro-cache*

# ==========================================
# WHITELIST - Always commit
# ==========================================
!package.json
!package-lock.json
!tsconfig.json
!app.json
!eas.json
!babel.config.js
!.gitignore
!docs/
!src/
!public/
!README.md
!assets/
