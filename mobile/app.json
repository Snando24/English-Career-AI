{
  "expo": {
    "name": "English Career AI",
    "slug": "english-career-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.englishcareer.app",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "This app uses local network discovery",
        "NSBonjourServiceTypes": ["_http._tcp"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.englishcareer.app",
      "versionCode": 1,
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "enableESM": true
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to access your face ID to secure user data."
        }
      ]
    ],
    "experiments": {
      "tsconfigPaths": true,
      "typedRoutes": false
    },
    "scheme": "englishcareer",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "12345678-1234-1234-1234-123456789012"
      },
      "apiUrl": "http://localhost:8080/api",
      "apiTimeout": 30000
    }
  }
}
