# Backend - Environment Variables Example
# Copy to backend/.env and update values

# ==========================================
# DATABASE
# ==========================================
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/english_career
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=dev_password_change_me
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# ==========================================
# JPA / HIBERNATE
# ==========================================
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=true

# ==========================================
# REDIS CACHE
# ==========================================
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=
SPRING_REDIS_DATABASE=0

# ==========================================
# JWT SECURITY
# ==========================================
JWT_SECRET=dev-secret-key-change-in-production-use-strong-random-string
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ==========================================
# OPENAI API
# ==========================================
OPENAI_API_KEY=sk-your-actual-openai-api-key
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.7
AI_EVALUATION_ENABLED=true
AI_CACHE_TTL_MINUTES=60

# ==========================================
# SERVER CONFIGURATION
# ==========================================
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/api
SPRING_APPLICATION_NAME=english-career-api

# ==========================================
# LOGGING
# ==========================================
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_ENGLISHCAREER=DEBUG
LOGGING_PATTERN_CONSOLE=%d{yyyy-MM-dd HH:mm:ss} - %msg%n

# ==========================================
# SPRINGDOC / SWAGGER
# ==========================================
SPRINGDOC_API_DOCS_PATH=/api-docs
SPRINGDOC_SWAGGER_UI_PATH=/swagger-ui.html
SPRINGDOC_SWAGGER_UI_ENABLED=true

# ==========================================
# OPTIONAL: EMAIL (Password Reset, Notifications)
# ==========================================
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-specific-password
# MAIL_FROM=noreply@englishcareer.ai

# ==========================================
# OPTIONAL: MONITORING & OBSERVABILITY
# ==========================================
# SENTRY_DSN=https://your-sentry-key@sentry.io/project-id
# SENTRY_ENVIRONMENT=development

# ==========================================
# ENVIRONMENT
# ==========================================
SPRING_PROFILES_ACTIVE=dev
APP_ENV=development

# ==========================================
# CORS & SECURITY
# ==========================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,exp://localhost:19000
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_MAX_AGE_SECONDS=3600

# ==========================================
# RATE LIMITING
# ==========================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_AI_REQUESTS_PER_MINUTE=10

# ==========================================
# SEED DATA
# ==========================================
SEED_DATABASE_ON_STARTUP=false
SEED_WITH_DEMO_DATA=false

# ==========================================
# SECURITY WARNING
# ==========================================
# NEVER commit actual values to Git!
# Use .env.local for local development
# Use secure secret management in production
