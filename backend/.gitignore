# Backend - Spring Boot / Java / Maven .gitignore

# ==========================================
# MAVEN
# ==========================================
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.bak
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# ==========================================
# IDE - IntelliJ IDEA
# ==========================================
.idea/
*.iml
*.iws
*.ipr
*.swp
*.swo
out/

# ==========================================
# IDE - Eclipse
# ==========================================
.classpath
.project
.settings/
.metadata
bin/

# ==========================================
# IDE - VS Code
# ==========================================
.vscode/
*.code-workspace
launch.json
settings.json

# ==========================================
# BUILD ARTIFACTS
# ==========================================
*.class
*.jar
*.war
*.ear
*.zip
*.tar.gz

# ==========================================
# SPRING BOOT SPECIFIC
# ==========================================
application-local.properties
application-dev.properties
application-prod.properties
application.local.yaml
application.dev.yaml

# ==========================================
# ENVIRONMENT & SECRETS
# ==========================================
.env
.env.local
.env.dev
.env.prod
.env.*.local
secrets/
credentials/

# ==========================================
# DATABASE
# ==========================================
postgres_data/
pgdata/
*.db
*.sqlite
*.sqlite3

# ==========================================
# GRADLE (if using)
# ==========================================
.gradle/
gradle-wrapper.jar
gradlew
gradlew.bat

# ==========================================
# LOGS
# ==========================================
logs/
*.log
*.log.*
npm-debug.log
yarn-debug.log

# ==========================================
# TEMPORARY FILES
# ==========================================
tmp/
temp/
*.swp
*.swo
*~
.tmp
.cache

# ==========================================
# OS SPECIFIC
# ==========================================
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.directory

# ==========================================
# TESTING
# ==========================================
coverage/
.nyc_output/
junit.xml
test-results/

# ==========================================
# SECURITY - NEVER COMMIT
# ==========================================
*.key
*.pem
*.jks
*.p12
.vault
vault-password

# ==========================================
# LOCAL DOCKER OVERRIDES
# ==========================================
docker-compose.override.yml
docker-compose.local.yml

# ==========================================
# WHITELIST - Always commit
# ==========================================
!pom.xml
!Dockerfile
!docker-compose.yml
!.gitignore
!docs/
!src/main/resources/db/migrations/
!README.md
