# English Career AI - Environment Variables Example
# Copy this file to .env and fill in your actual values
# NEVER commit .env files to Git!

# ==========================================
# BACKEND CONFIGURATION
# ==========================================

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=english_career
DB_USER=admin
DB_PASSWORD=dev_password_change_me

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Server
SERVER_PORT=8080
SERVER_ENV=development

# ==========================================
# AI CONFIGURATION (OpenAI)
# ==========================================

OPENAI_API_KEY=sk-your-actual-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.7
OPENAI_TIMEOUT=30000

# ==========================================
# MOBILE CONFIGURATION
# ==========================================

# API Endpoint
EXPO_PUBLIC_API_URL=http://localhost:8080/api
EXPO_PUBLIC_API_TIMEOUT=30000

# Environment
EXPO_PUBLIC_ENV=development

# Optional: Analytics/Logging
EXPO_PUBLIC_ANALYTICS_ENABLED=false
EXPO_PUBLIC_LOG_LEVEL=info

# ==========================================
# OPTIONAL: AWS / Cloud Configuration
# ==========================================

# AWS (if using S3 for file storage)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=english-career-ai

# ==========================================
# OPTIONAL: THIRD PARTY SERVICES
# ==========================================

# Email (for password reset, notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# Sentry (Error tracking)
# SENTRY_DSN=https://your-sentry-dsn

# DataDog (Monitoring)
# DATADOG_API_KEY=your-datadog-api-key
# DATADOG_APP_KEY=your-datadog-app-key

# ==========================================
# SECURITY WARNING
# ==========================================
# This is an EXAMPLE file. NEVER commit actual secrets to Git!
# Use .env.local or .env.*.local for local development
# Use secure secret management (AWS Secrets Manager, HashiCorp Vault) in production
